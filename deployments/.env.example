# Шаблон настроек локальной инфраструктуры. Скопируйте в .env:
#   cp .env.example .env
# Файл .env не коммитится (см. .gitignore). Значения ниже — только для разработки.

# --- PostgreSQL ---
POSTGRES_USER=herald
POSTGRES_PASSWORD=herald
POSTGRES_DB=herald
POSTGRES_PORT=5432
POSTGRES_VERSION=17

# --- RabbitMQ (профиль rabbitmq) ---
RABBITMQ_USER=herald
RABBITMQ_PASSWORD=herald
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_VERSION=4

# --- Kafka ---
# Порт для подключения с хоста. Внутри сети Docker брокер доступен как kafka:9092.
KAFKA_EXTERNAL_PORT=29092
KAFKA_VERSION=3.9.0

# --- Kafka UI (профиль tools) ---
KAFKA_UI_PORT=8080
KAFKA_UI_VERSION=v0.7.2

# --- Заглушки провайдеров (профиль providers) ---
MAILPIT_VERSION=latest
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
PROVIDERSIM_PORT=8090
# Начальный режим providersim. Дальше меняется в интерфейсе http://localhost:8090
SIM_LATENCY_MS=50
SIM_FAIL_RATE=0
SIM_THROTTLE_RATE=0
SIM_HANG_RATE=0
